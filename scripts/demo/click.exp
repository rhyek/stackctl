#!/usr/bin/env expect -f
#
# The demo's double-click. VHS can only send keystrokes — it has no mouse command — so the
# recording drives stackctl through this transparent expect wrapper, which forwards every
# byte both ways and, at one scripted moment, writes a mouse report into stackctl's stdin
# itself. That report is the real thing (SGR, `ESC[<btn;col;rowM`, what any terminal sends
# under `?1002h`/`?1006h`), so what the GIF shows is stackctl's actual double-click-to-copy:
# word highlight, `✓ copied 5 chars to clipboard`, and the word really on the clipboard —
# which is what the tape then pastes into the filter.
#
# It has to be a single write: stackctl parses each stdin chunk on its own, and the two
# presses must land inside DOUBLE_CLICK_MS (see word-select.ts) of each other to read as a
# double-click.
#
# Not run directly — demo.tape execs it, and `record.sh` renders the tape.

# Match the spawned pty to the recording terminal (VHS renders 35x111 at the tape's font
# size), so stackctl lays out exactly as it would without the wrapper.
set size [exec stty size <@ stdin]
set term_rows [lindex $size 0]
set term_cols [lindex $size 1]
set stty_init "rows $term_rows columns $term_cols"

# Where to click. The column is read off stackctl's own output, once the command has finished
# (`added_column` below): a log line opens with its time and its service's label, padded to the
# session's label width, so where `Added` of `Added todo: …` starts depends on the example's
# names. The click lands two cells into the word.
#
# The footer is 5 rows tall in normal mode, so the newest log line sits on row rows-5 and
# the command's own output ends `Added todo:` x5 then `✔ add-random-todo finished`. Row
# rows-9 is four rows above the newest, which lands on one of those five `Added` lines
# whether nothing has arrived since (rows-9 is the 2nd) or the worker's three-line
# heartbeat has (rows-9 is the 5th) — the click waits out one beat, so at most one tick
# can land in between. Re-derive the row if the footer grows a line or the worker's tick stops
# being three lines.
set click_row [expr {$term_rows - 9}]

# The session's logfile holds every line as the screen draws it, with the date in front and the
# label padded by the same function: `2026-11-10 15:45:27 [backend   ] Added todo: …`. The screen
# shows the time alone (`15:45:27 `), so a cell on screen is its index in the file line minus the
# date's 11, plus one (columns count from 1). Reading a small file takes a few milliseconds, so
# the relay never stalls on it.
set logs_dir [file normalize [file join [file dirname [info script]] ../../example/node_modules/.stackctl/modes/development/logs]]
proc added_column {logs_dir} {
    set files [lsort -command {apply {{a b} {expr {[file mtime $a] - [file mtime $b]}}}} [glob -nocomplain -directory $logs_dir *.log]]
    if {[llength $files] == 0} {
        error "no session logfile in $logs_dir"
    }
    set f [open [lindex $files end]]
    set lines [split [read $f] "\n"]
    close $f
    for {set i [expr {[llength $lines] - 1}]} {$i >= 0} {incr i -1} {
        set at [string first "\] Added todo" [lindex $lines $i]]
        if {$at >= 0 && [string match {*\[backend*} [lindex $lines $i]]} {
            # `Added` starts two past the bracket; aim two cells into it.
            return [expr {$at + 2 - 11 + 1 + 2}]
        }
    }
    error "no `Added todo` line from the backend in [lindex $files end]"
}

spawn -noecho bash

# Forward everything until the backend's add-random-todo has printed its last line, then click.
# The pattern match is what keeps the click in sync with the logs — the tape's sleeps only
# have to be long enough to leave the copy notice on screen afterwards. Wrapped in a proc
# so `return` ends this one interact rather than the script; the click must fire once,
# since a second one inside the double-click window would escalate to a triple-click
# (whole-line select) and copy the wrong thing.
#
# `-ex` (exact), never `-re`: a regexp pattern makes interact rescan its buffer per chunk
# and relays roughly ten times slower (a 32KB repaint takes ~10ms to get through instead of
# ~1ms). That is slow enough for the recorder to photograph a frame with the repaint only
# half applied — the top of the screen redrawn and everything below it still blank.
proc forward_until_command_done {} {
    interact -o -nobuffer -ex "add-random-todo finished" return
}
forward_until_command_done

set click_col [added_column $logs_dir]

# A beat before the click, so it reads as a deliberate act on a settled screen rather than
# something that happened while the logs were still moving. It must NOT be `sleep`: that
# stops draining the pty, which freezes the recording mid-repaint — a captured frame then
# shows a half-painted screen with no footer. Waiting for `timeout` instead keeps expect
# reading (and, with log_user on, echoing) everything for the whole beat, so the screen
# stays live.
set timeout 2
expect timeout

# Press, release, press, release — `M` opens a report, `m` closes it — in a single write.
set report "\033\[<0;$click_col;$click_row"
send -- "${report}M${report}m${report}M${report}m"

interact
